# Copy to robot.env beside each robot's ./run. No credentials in this file.
INSPECT_ROBOTS_BIN=/absolute/path/to/venv/bin/inspect-robots
INSPECT_ROBOTS_CONFIG=/absolute/path/to/calibrated/robot/config.ini
ROBOT_DOCS_DIR=/absolute/path/to/robot-docs
# ROBOT_DOCS_DIR must contain facts.md, advice-eef.md, advice-joints.md.
# Optional RERUN_CONNECT=rerun+http://127.0.0.1:9876/proxy
